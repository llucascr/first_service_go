{
	"info": {
		"name": "first_service_go - MetaTagContent",
		"description": "CRUD do escopo MetaTagContent (tabela de juncao tag<->content, PK composta content_id+tag_id). IDs (user_id, notebook_id, content_id, tag_id) sao enviados via Header, seguindo o padrao dos handlers.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "develop",
			"value": "http://localhost:8080"
		},
		{
			"key": "user_id",
			"value": "11111111-1111-1111-1111-111111111111"
		},
		{
			"key": "notebook_id",
			"value": "22222222-2222-2222-2222-222222222222"
		},
		{
			"key": "content_id",
			"value": "33333333-3333-3333-3333-333333333333"
		},
		{
			"key": "tag_id",
			"value": "55555555-5555-5555-5555-555555555555"
		}
	],
	"item": [
		{
			"name": "Create MetaTagContent",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "user_id", "value": "{{user_id}}" },
					{ "key": "notebook_id", "value": "{{notebook_id}}" },
					{ "key": "content_id", "value": "{{content_id}}" },
					{ "key": "tag_id", "value": "{{tag_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent" ]
				},
				"description": "Cria a associacao tag<->content. user_id, notebook_id, content_id e tag_id vem do Header. A identidade e a chave composta (content_id, tag_id)."
			}
		},
		{
			"name": "List MetaTagContents from Content",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "content_id", "value": "{{content_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent/list/content",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent", "list", "content" ]
				},
				"description": "Lista todas as tags associadas a um content (content_id via Header)."
			}
		},
		{
			"name": "List MetaTagContents from Tag",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "tag_id", "value": "{{tag_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent/list/tag",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent", "list", "tag" ]
				},
				"description": "Lista todos os contents associados a uma tag (tag_id via Header)."
			}
		},
		{
			"name": "List MetaTagContents from Notebook",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "notebook_id", "value": "{{notebook_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent/list/notebook",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent", "list", "notebook" ]
				},
				"description": "Lista todas as associacoes de um notebook (notebook_id via Header)."
			}
		},
		{
			"name": "Get MetaTagContent",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "content_id", "value": "{{content_id}}" },
					{ "key": "tag_id", "value": "{{tag_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent" ]
				},
				"description": "Busca uma associacao pela chave composta (content_id, tag_id) via Header."
			}
		},
		{
			"name": "Update MetaTagContent",
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "content_id", "value": "{{content_id}}" },
					{ "key": "tag_id", "value": "{{tag_id}}" },
					{ "key": "notebook_id", "value": "{{notebook_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent" ]
				},
				"description": "Re-aponta a associacao para outro notebook_id. content_id e tag_id (chave) e notebook_id (novo valor) via Header."
			}
		},
		{
			"name": "Delete MetaTagContent",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "content_id", "value": "{{content_id}}" },
					{ "key": "tag_id", "value": "{{tag_id}}" }
				],
				"url": {
					"raw": "{{develop}}/metatagcontent",
					"host": [ "{{develop}}" ],
					"path": [ "metatagcontent" ]
				},
				"description": "Soft delete da associacao pela chave composta (content_id, tag_id) via Header. Retorna 204 No Content."
			}
		}
	]
}