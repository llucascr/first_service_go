{
	"info": {
		"name": "first_service_go - NodesContent",
		"description": "CRUD do escopo NodesContent. IDs (user_id, notebook_id, content_id, node_id) sao enviados via Header, seguindo o padrao dos handlers.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "develop",
			"value": "http://localhost:8080"
		},
		{
			"key": "user_id",
			"value": "11111111-1111-1111-1111-111111111111"
		},
		{
			"key": "notebook_id",
			"value": "22222222-2222-2222-2222-222222222222"
		},
		{
			"key": "content_id",
			"value": "33333333-3333-3333-3333-333333333333"
		},
		{
			"key": "node_id",
			"value": "44444444-4444-4444-4444-444444444444"
		}
	],
	"item": [
		{
			"name": "Create NodesContent",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "user_id", "value": "{{user_id}}" },
					{ "key": "notebook_id", "value": "{{notebook_id}}" },
					{ "key": "content_id", "value": "{{content_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent" ]
				},
				"description": "Cria um NodesContent. user_id, notebook_id e content_id vem do Header. O node_id e gerado pela aplicacao."
			}
		},
		{
			"name": "List NodesContents from Notebook",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "notebook_id", "value": "{{notebook_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent/list/notebook",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent", "list", "notebook" ]
				},
				"description": "Lista todos os NodesContents de um notebook (notebook_id via Header)."
			}
		},
		{
			"name": "List NodesContents from Content",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "content_id", "value": "{{content_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent/list/content",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent", "list", "content" ]
				},
				"description": "Lista todos os NodesContents vinculados a um meta_content (content_id via Header)."
			}
		},
		{
			"name": "Get NodesContent by ID",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "node_id", "value": "{{node_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent" ]
				},
				"description": "Busca um NodesContent pelo node_id (via Header)."
			}
		},
		{
			"name": "Update NodesContent",
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "node_id", "value": "{{node_id}}" },
					{ "key": "content_id", "value": "{{content_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent" ]
				},
				"description": "Re-aponta o vinculo do node para outro content_id. node_id e content_id via Header."
			}
		},
		{
			"name": "Delete NodesContent",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "node_id", "value": "{{node_id}}" }
				],
				"url": {
					"raw": "{{develop}}/nodescontent",
					"host": [ "{{develop}}" ],
					"path": [ "nodescontent" ]
				},
				"description": "Soft delete do NodesContent (node_id via Header). Retorna 204 No Content."
			}
		}
	]
}
